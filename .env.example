# Copy to .env for local runs. The app loads .env on startup.
# Process environment and Docker settings override these values.
# Do not commit .env.

# SQLite file used by a local uvicorn process.
# The Docker image overrides this to sqlite+aiosqlite:////data/skyflow.db
DATABASE_URL=sqlite+aiosqlite:///./skyflow.db

# Cumulative delay (minutes) at which meal demand grows by SAFETY_BUFFER_PCT.
LONG_DELAY_THRESHOLD_MINUTES=60

# Extra meals for a long-delayed flight. 0.05 means 5 percent, rounded up.
SAFETY_BUFFER_PCT=0.05

# How long shutdown waits for in-flight meal recalculations.
SHUTDOWN_GRACE_SECONDS=10

# Simulator only (python -m app.simulator.flight_simulator). Not read by the API.
SKYFLOW_API_URL=http://localhost:8000
SIM_MIN_INTERVAL=15
SIM_MAX_INTERVAL=30
